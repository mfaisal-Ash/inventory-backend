APP_ENV=development
APP_PORT=8080

# Jaringan gudang (CIDR/IP, pisahkan dengan koma). Kalau diisi, akun KARYAWAN hanya
# bisa login & memakai API dari IP ini; admin/super admin tidak dibatasi.
# Kosong = tanpa pembatasan. Nilai ini hanya NILAI AWAL: begitu super admin menyimpan
# daftar lewat Manajemen User > Akses Jaringan Karyawan, daftar di database yang dipakai.
# Backend WAJIB di belakang reverse proxy tepercaya (nginx) yang menimpa header
# X-Forwarded-For dengan IP klien asli ($remote_addr), dan IP proxy itu harus ada di
# TRUSTED_PROXIES (default 127.0.0.1/32, ::1/128). Lihat deploy/nginx/wms.conf.
# Contoh: KARYAWAN_ALLOWED_NETWORKS=192.168.1.0/24,203.0.113.10
KARYAWAN_ALLOWED_NETWORKS=

# true = akun ADMIN ikut dibatasi ke jaringan gudang di atas (super admin tetap bebas,
# jadi tidak mungkin terkunci). Nilai awal saja; super admin bisa mengubahnya lewat
# Manajemen User > Akses Jaringan Gudang. Tidak berefek kalau daftar jaringan kosong.
ADMIN_GUDANG_ONLY=false

# Akun admin & karyawan hanya bisa login/dipakai dari sekitar titik koordinat gudang
# (Latitude/Longitude di Manajemen Gudang), dalam radius (meter) berikut. Super admin
# bisa diakses dari mana saja. Kalau belum ada gudang yang koordinatnya terisi, tidak
# ada pembatasan. Browser harus mengizinkan akses lokasi (butuh HTTPS, kecuali localhost).
GEOFENCE_RADIUS_METERS=20

# Production: bind ke loopback supaya hanya nginx yang bisa menjangkau backend.
# APP_HOST=127.0.0.1
# CORS_ALLOWED_ORIGINS=https://wms.example.com

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=stockrsd
DB_SSLMODE=disable

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

CAPTCHA_SECRET=
BOTCHECK_SECRET=

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_GITHUB_OWNER=mfaisal-Ash
AUTO_UPDATE_GITHUB_REPO=inventory-backend
# Aktifkan hanya setelah path, permission, sudoers, dan signature release diverifikasi.
AUTO_UPDATE_SCRIPT_PATH=/opt/inventory/backend/deploy/scripts/self-update.sh
AUTO_UPDATE_WORKDIR=/opt/inventory/backend
AUTO_UPDATE_SERVICE_NAME=inventory-backend
AUTO_UPDATE_STATUS_PATH=/opt/inventory/backend/var/run/self-update-status.json
