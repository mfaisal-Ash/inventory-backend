APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=stockrsd
DB_SSLMODE=disable

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

CAPTCHA_SECRET=
BOTCHECK_SECRET=

WHATSAPP_DRIVER=gateway
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=
WHATSMEOW_SESSION_PATH=./var/whatsmeow-session.db

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

PASSWORD_RESET_SECRET=
PASSWORD_RESET_TTL_MINUTES=10

# Cek Update / Update Sekarang (Settings > Sistem) — lihat
# docs/self-update-setup.md untuk panduan setup lengkap di VPS.
# AUTO_UPDATE_ENABLED=false berarti GET /app/check-update &
# /app/update-status tetap jalan (murni baca), tapi POST /app/update
# ditolak — aman dibiarkan false sampai server benar-benar disiapkan.
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_GITHUB_OWNER=projsonal
AUTO_UPDATE_GITHUB_REPO=gowms
AUTO_UPDATE_SCRIPT_PATH=./deploy/scripts/self-update.sh
AUTO_UPDATE_WORKDIR=.
AUTO_UPDATE_SERVICE_NAME=gowms-backend
AUTO_UPDATE_STATUS_PATH=./var/run/self-update-status.json
