{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/health": {
            "get": {
                "description": "Laporan status seluruh komponen inti (DB, dsb).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check lengkap",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/health/ready": {
            "get": {
                "description": "Mengecek apakah aplikasi siap menerima traffic (termasuk cek koneksi DB, dsb).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Readiness probe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/auth/login": {
            "post": {
                "description": "Login dengan username \u0026 password. Jika 2FA belum aktif, respons meminta setup 2FA; jika sudah aktif, meminta verifikasi OTP.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "Kredensial login",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/utils.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.LoginResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "username/password salah",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "403": {
                        "description": "akun tidak aktif",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "429": {
                        "description": "akun terkunci sementara",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Revoke seluruh sesi/refresh token milik user yang sedang login.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Logout",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/auth/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Mengambil data user yang sedang login berdasarkan access token.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Profil user aktif",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/utils.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.MeResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/auth/refresh": {
            "post": {
                "description": "Tukar refresh token yang masih valid dengan pasangan access+refresh token baru.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Perbarui access token",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RefreshTokenRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/utils.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.LoginResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "refresh token tidak valid/kedaluwarsa/di-revoke",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/auth/register": {
            "post": {
                "description": "Mendaftarkan user baru. Wajib menyertakan token \u0026 jawaban captcha yang valid.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Registrasi akun baru",
                "parameters": [
                    {
                        "description": "Data registrasi",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/auth.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/utils.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/auth.LoginResponse"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "captcha gagal / payload tidak valid",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "409": {
                        "description": "username/email sudah dipakai",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/barang": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Daftar barang dengan pagination \u0026 filter.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Barang"
                ],
                "summary": "Daftar barang",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "Halaman",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 10,
                        "description": "Item per halaman",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Kata kunci pencarian",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Filter kategori",
                        "name": "kategori_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Filter satuan",
                        "name": "satuan_id",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Hanya tampilkan stok menipis",
                        "name": "stok_menipis",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "aktif untuk hanya barang aktif",
                        "name": "status",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Barang"
                ],
                "summary": "Tambah barang baru",
                "parameters": [
                    {
                        "description": "Data barang",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/barang.BarangRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "409": {
                        "description": "kode barang sudah dipakai",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        },
        "/wms-rsd/barang/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Barang"
                ],
                "summary": "Detail barang",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID barang",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/utils.Envelope"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "minLength": 6
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "auth.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "pending_token": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string"
                },
                "require_otp": {
                    "type": "boolean"
                },
                "require_setup_2fa": {
                    "type": "boolean"
                },
                "session": {
                    "$ref": "#/definitions/auth.SessionInfo"
                },
                "token_type": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/definitions/auth.UserSummary"
                }
            }
        },
        "auth.MeResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "is_2fa_enabled": {
                    "type": "boolean"
                },
                "phone_number": {
                    "type": "string"
                },
                "role_id": {
                    "type": "integer"
                },
                "role_name": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "auth.RefreshTokenRequest": {
            "type": "object",
            "required": [
                "refresh_token"
            ],
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "auth.RegisterRequest": {
            "type": "object",
            "required": [
                "captcha_answer",
                "captcha_token",
                "email",
                "full_name",
                "password",
                "password_confirmation",
                "username"
            ],
            "properties": {
                "captcha_answer": {
                    "type": "string"
                },
                "captcha_token": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "full_name": {
                    "type": "string"
                },
                "password": {
                    "type": "string",
                    "minLength": 8
                },
                "password_confirmation": {
                    "type": "string"
                },
                "phone_number": {
                    "type": "string"
                },
                "role_name": {
                    "type": "string",
                    "enum": [
                        "super_admin",
                        "admin",
                        "karyawan",
                        "analis_data"
                    ]
                },
                "username": {
                    "type": "string",
                    "maxLength": 50,
                    "minLength": 4
                }
            }
        },
        "auth.SessionInfo": {
            "type": "object",
            "properties": {
                "browser": {
                    "type": "string"
                },
                "browser_version": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "device_type": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "ip_address": {
                    "type": "string"
                },
                "location": {
                    "type": "string"
                },
                "os": {
                    "type": "string"
                },
                "os_version": {
                    "type": "string"
                }
            }
        },
        "auth.UserSummary": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "role_id": {
                    "type": "integer"
                },
                "role_name": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "barang.BarangRequest": {
            "type": "object",
            "required": [
                "kategori_id",
                "kode_barang",
                "nama",
                "satuan_id"
            ],
            "properties": {
                "deskripsi": {
                    "type": "string",
                    "maxLength": 255
                },
                "harga_beli": {
                    "type": "integer",
                    "minimum": 0
                },
                "kategori_id": {
                    "type": "integer"
                },
                "kode_barang": {
                    "type": "string",
                    "maxLength": 30
                },
                "nama": {
                    "type": "string",
                    "maxLength": 150
                },
                "satuan_id": {
                    "type": "integer"
                },
                "stok_minimum": {
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "utils.Envelope": {
            "type": "object",
            "properties": {
                "data": {},
                "errors": {},
                "message": {
                    "type": "string"
                },
                "meta": {},
                "success": {
                    "type": "boolean"
                }
            }
        }
    }
}