APP_ENV=development
APP_PORT=8080

# IP LAN PC ini berubah-ubah tiap konek WiFi baru (DHCP) — kalau HP masih
# "situs tidak dapat dijangkau" / request ke backend gagal, cek IP terbaru
# dengan `ipconfig` (cari "IPv4 Address" di adapter WiFi aktif), lalu update
# baris di bawah ini SEKALIGUS dengan NEXT_PUBLIC_API_BASE_URL di
# wms/.env.local (frontend) supaya keduanya selalu sama-sama menunjuk ke IP
# yang sama. Karena login pakai Bearer token (bukan cookie), aman pakai "*"
# di development kalau malas update IP terus — TAPI JANGAN dipakai di
# production (buka API ke semua origin).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.7:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=t4mp4n
DB_NAME=wms-rsd
DB_SSLMODE=disable

WHATSAPP_DRIVER=gateway
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=wms-RSD
WHATSMEOW_SESSION_PATH=./var/whatsmeow-session.db

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=wms-RSD

PASSWORD_RESET_SECRET=change-me-password-reset-secret
PASSWORD_RESET_TTL_MINUTES=10

# Dev lokal: fitur update online dimatikan default (aman) — lihat
# .env.example untuk penjelasan tiap variabel & docs/self-update-setup.md
# untuk cara mengaktifkannya di VPS produksi.
AUTO_UPDATE_ENABLED=false